<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Deuktemsiru_seller" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface_alt</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/surface</item>
        <item name="colorOnSurfaceVariant">@color/text_sub</item>
        <item name="colorOutline">@color/text_muted</item>
        <item name="colorOutlineVariant">@color/border</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:navigationBarColor">@color/surface_alt</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/surface_alt</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNav</item>
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="android:textViewStyle">@style/Widget.App.TextView</item>
    </style>

    <style name="Theme.Deuktemsiru_seller" parent="Base.Theme.Deuktemsiru_seller" />

    <style name="Widget.App.TextView" parent="android:style/Widget.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.47</item>
    </style>

    <style name="Widget.App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.ActiveIndicator</item>
    </style>

    <style name="Widget.App.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_light</item>
    </style>

    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="TextAppearance.App.Micro" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <style name="Widget.App.Button.Dark" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <style name="Widget.App.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/surface_elevation</item>
        <item name="cardBackgroundColor">@color/surface_alt</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border</item>
    </style>
</resources>
