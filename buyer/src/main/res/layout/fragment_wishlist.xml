<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/ll_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_alt"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:elevation="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wishlist_title"
            android:textSize="@dimen/text_title"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text" />

        <LinearLayout
            android:id="@+id/ll_search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_bar"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:contentDescription="검색"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/et_wishlist_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="@string/home_search_hint"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text"
                android:textColorHint="@color/text_muted"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/btn_wishlist_search"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_search"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="검색" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="10dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chip_all"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/cat_all"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_chip_selected"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_korean"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/cat_korean"
                    android:textSize="13sp"
                    android:textColor="@color/text"
                    android:background="@drawable/bg_chip_unselected"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_western"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/cat_western"
                    android:textSize="13sp"
                    android:textColor="@color/text"
                    android:background="@drawable/bg_chip_unselected"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_cafe_dessert"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/cat_cafe_dessert"
                    android:textSize="13sp"
                    android:textColor="@color/text"
                    android:background="@drawable/bg_chip_unselected"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_bakery"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/cat_bakery"
                    android:textSize="13sp"
                    android:textColor="@color/text"
                    android:background="@drawable/bg_chip_unselected"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_cafe"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/cat_cafe"
                    android:textSize="13sp"
                    android:textColor="@color/text"
                    android:background="@drawable/bg_chip_unselected" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_wishlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/spacing_lg"
            android:clipToPadding="false"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/wishlist_empty_title"
                android:textSize="@dimen/text_title"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text" />
            <TextView
                android:id="@+id/tv_empty_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/wishlist_empty_body"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_sub" />
            <Button
                android:id="@+id/btn_empty_action"
                style="@style/RecoveryAction"
                android:text="@string/browse_stores" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible" />
    </FrameLayout>
</LinearLayout>
